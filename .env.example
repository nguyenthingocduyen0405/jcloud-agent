# Local development only. Never put passwords, tokens, or cloud credentials here.
DATABASE_PATH=data/jcloud_agent.db
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_URL=http://127.0.0.1:8000

# LLM parsing layer. Auto uses OpenAI when a key exists, otherwise the safe mock fallback.
LLM_PROVIDER=auto
LLM_MODEL=gpt-5-nano
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=500
LLM_REASONING_EFFORT=minimal
LLM_FAST_PATH=true

# Free OpenRouter fallback. Keep the key in local/Render secrets only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_OUTPUT_TOKENS=500
OPENROUTER_ATTEMPTS=2
